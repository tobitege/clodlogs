<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Clodlogs.Desktop.ViewModels"
        x:Class="Clodlogs.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="clodlogs"
        Width="1600"
        Height="1000"
        MinWidth="980"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.kicker">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="#2463523A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="#2463523A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#60FFFFFF" />
      <Setter Property="BorderBrush" Value="#2463523A" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBox.session-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="clodlogs" FontSize="42" FontFamily="Georgia" FontWeight="Bold" />
          <Button Classes="ghost" Content="GitHub" Command="{CompiledBinding OpenRepositoryCommand}" />
        </StackPanel>
        <TextBlock Classes="muted" Text="Browse Claude session logs, inspect transcripts, export sessions, and create sanitized copies." />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="kicker" Text="SESSIONS" />
            <TextBlock Text="{CompiledBinding SessionCountText}" FontSize="22" FontWeight="Bold" />
            <TextBlock Classes="muted" Text="{CompiledBinding ScopeText}" />
          </StackPanel>
        </Border>
        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="kicker" Text="SIZE" />
            <TextBlock Text="{CompiledBinding TotalSizeText}" FontSize="22" FontWeight="Bold" />
            <TextBlock Classes="muted" Text="{CompiledBinding LiveCountText}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Classes="panel" Padding="14">
      <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="*,*,Auto,Auto,Auto" ColumnSpacing="8">
          <TextBox PlaceholderText="Folder path" Text="{CompiledBinding FolderPath, Mode=TwoWay}" />
          <TextBox Grid.Column="1" PlaceholderText="Claude home override" Text="{CompiledBinding ClaudeHome, Mode=TwoWay}" />
          <Button Grid.Column="2" Classes="ghost" Content="Browse Folder" Command="{CompiledBinding BrowseFolderCommand}" />
          <Button Grid.Column="3" Classes="ghost" Content="All Sessions" Command="{CompiledBinding ShowAllSessionsCommand}" />
          <Button Grid.Column="4" Classes="primary" Content="Refresh" Command="{CompiledBinding RefreshCommand}" />
        </Grid>
        <WrapPanel Grid.Row="1" VerticalAlignment="Center">
          <TextBox Width="200"
                   Margin="0,0,14,0"
                   PlaceholderText="Filter sessions..."
                   Text="{CompiledBinding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <CheckBox Margin="0,0,14,0" Content="CWD only" IsChecked="{CompiledBinding CwdOnly, Mode=TwoWay}" />
          <CheckBox Margin="0,0,14,0" Content="Include cross-session writes" IsChecked="{CompiledBinding IncludeCrossSessionWrites, Mode=TwoWay}" />
          <CheckBox Margin="0,0,14,0" Content="Live" IsChecked="{CompiledBinding ShowLiveSessions, Mode=TwoWay}" />
          <CheckBox Margin="0,0,14,0" Content="Archived" IsChecked="{CompiledBinding ShowArchivedSessions, Mode=TwoWay}" />
          <TextBlock Margin="0,0,6,0" Classes="muted" Text="From" VerticalAlignment="Center" />
          <TextBox Width="110" Margin="0,0,10,0" PlaceholderText="yyyy-mm-dd" Text="{CompiledBinding DateFrom, Mode=TwoWay}" />
          <TextBlock Margin="0,0,6,0" Classes="muted" Text="To" VerticalAlignment="Center" />
          <TextBox Width="110" PlaceholderText="yyyy-mm-dd" Text="{CompiledBinding DateTo, Mode=TwoWay}" />
        </WrapPanel>
        <Border Grid.Row="2"
                Background="#18B0522F"
                BorderBrush="#55B0522F"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,8"
                IsVisible="{CompiledBinding HasPartialSessionResults}">
          <TextBlock Text="{CompiledBinding PartialSessionResultsMessage}"
                     Foreground="{DynamicResource AccentBrush}"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="390,*" ColumnSpacing="14">
      <Border Classes="panel">
        <Grid RowDefinitions="Auto,*">
          <Grid Margin="14" ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Button Width="28"
                    Height="28"
                    Padding="0"
                    Classes="ghost"
                    Content="&#x2630;"
                    FontSize="17"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    VerticalAlignment="Top"
                    ToolTip.Tip="Session actions">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="Batch Export" Command="{CompiledBinding OpenBatchExportDialogCommand}" />
                  <MenuItem Header="Token Summary" Command="{CompiledBinding OpenTokenSummaryCommand}" />
                  <MenuItem Header="Options" Command="{CompiledBinding OpenOptionsCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock Text="Sessions" FontSize="22" FontFamily="Georgia" FontWeight="Bold" />
              <TextBlock Classes="muted" Text="{CompiledBinding ArchivedCountText}" />
            </StackPanel>
          </Grid>
          <ListBox Grid.Row="1"
                   Classes="session-list"
                   ItemsSource="{CompiledBinding FilteredSessions}"
                   SelectedItem="{CompiledBinding SelectedSession, Mode=TwoWay}"
                   Padding="12">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SessionCardViewModel">
                <Border Classes="card">
                  <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                      <Border Background="#22357B84" CornerRadius="5" Padding="6,3">
                        <TextBlock Text="{CompiledBinding KindLabel}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryBrush}" />
                      </Border>
                      <TextBlock Grid.Column="1" Text="{CompiledBinding UpdatedAtLabel}" Classes="muted" HorizontalAlignment="Right" />
                      <Border Grid.Column="2" IsVisible="{CompiledBinding IsLarge}" Background="#22B0522F" CornerRadius="10" Padding="6,3">
                        <TextBlock Text="{CompiledBinding FileSizeLabel}" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                      </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{CompiledBinding Title}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="2" Text="{CompiledBinding Cwd}" Classes="muted" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="panel">
        <ScrollViewer>
          <StackPanel Margin="18" Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="{CompiledBinding SelectedTitle}" FontSize="30" FontFamily="Georgia" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Text="{CompiledBinding SelectedCwd}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
              <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button Classes="ghost" Content="Replay" Command="{CompiledBinding OpenTranscriptCommand}" />
                <Button Classes="ghost" Content="Sanitize" Command="{CompiledBinding OpenSanitizeDialogCommand}" />
                <Button Classes="primary" Content="Export" Command="{CompiledBinding OpenExportDialogCommand}" />
              </WrapPanel>
            </Grid>

            <Border Classes="card" IsVisible="{CompiledBinding HasAnalysisBanner}">
              <TextBlock Text="{CompiledBinding AnalysisBannerText}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" />
            </Border>

            <UniformGrid Columns="3" Rows="2">
              <Border Classes="card" Margin="0,0,8,8">
                <StackPanel>
                  <TextBlock Classes="kicker" Text="INTERACTIONS" />
                  <TextBlock Text="{CompiledBinding InteractionSummary}" FontWeight="SemiBold" />
                </StackPanel>
              </Border>
              <Border Classes="card" Margin="0,0,8,8">
                <StackPanel>
                  <TextBlock Classes="kicker" Text="TOKENS" />
                  <TextBlock Text="{CompiledBinding TokenSummaryText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Classes="card" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Classes="kicker" Text="FILE SIZE" />
                  <TextBlock Text="{CompiledBinding SelectedFileSize}" FontWeight="SemiBold" />
                </StackPanel>
              </Border>
              <Border Classes="card" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Classes="kicker" Text="STARTED" />
                  <TextBlock Text="{CompiledBinding SelectedStartedAt}" FontWeight="SemiBold" />
                </StackPanel>
              </Border>
              <Border Classes="card" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Classes="kicker" Text="UPDATED" />
                  <TextBlock Text="{CompiledBinding SelectedUpdatedAt}" FontWeight="SemiBold" />
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel>
                  <TextBlock Classes="kicker" Text="SOURCE" />
                  <TextBlock Text="{CompiledBinding SelectedSource}" FontWeight="SemiBold" />
                </StackPanel>
              </Border>
            </UniformGrid>

            <WrapPanel>
              <Button Classes="ghost" Content="Analyze Anyway" Command="{CompiledBinding AnalyzeAnywayCommand}" />
              <Button Classes="ghost" Content="Copy Token Usage" Command="{CompiledBinding CopySelectedTokenUsageCommand}" />
              <Button Classes="ghost" Content="Open File" Command="{CompiledBinding OpenSelectedFileCommand}" />
              <Button Classes="ghost" Content="Reveal File" Command="{CompiledBinding RevealSelectedFileCommand}" />
            </WrapPanel>

            <Border Classes="card">
              <StackPanel Spacing="6">
                <TextBlock Classes="kicker" Text="SESSION FILE" />
                <SelectableTextBlock Text="{CompiledBinding SelectedFile}" FontFamily="Cascadia Code, Consolas" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="6">
                <TextBlock Classes="kicker" Text="ENVIRONMENT" />
                <TextBlock Text="{CompiledBinding EnvironmentSummary}" FontWeight="SemiBold" />
                <TextBlock Text="{CompiledBinding ClaudeHomeText}" Classes="muted" TextWrapping="Wrap" />
                <TextBlock Text="{CompiledBinding EnvironmentNotes}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
      <TextBlock Text="{CompiledBinding StatusMessage}" Classes="muted" VerticalAlignment="Center" />
      <ProgressBar Grid.Column="1" Width="180" IsIndeterminate="True" IsVisible="{CompiledBinding IsLoading}" />
    </Grid>

    <Border Grid.RowSpan="4" Background="#88000000" IsVisible="{CompiledBinding HasError}">
      <Border Classes="panel" Width="560" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock Text="Error" FontSize="24" FontWeight="Bold" />
          <TextBlock Text="{CompiledBinding ErrorMessage}" TextWrapping="Wrap" />
          <Button Classes="primary" Content="Dismiss" Command="{CompiledBinding DismissDialogsCommand}" HorizontalAlignment="Right" />
        </StackPanel>
      </Border>
    </Border>

    <Border Grid.RowSpan="4" Background="#88000000" IsVisible="{CompiledBinding ExportDialogVisible}">
      <Border Classes="panel" Width="720" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock Classes="kicker" Text="EXPORT SESSION" />
          <TextBlock Text="{CompiledBinding SelectedTitle}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
          <ComboBox ItemsSource="{CompiledBinding ExportFormats}" SelectedItem="{CompiledBinding ExportFormat, Mode=TwoWay}" />
          <CheckBox Content="Include images" IsChecked="{CompiledBinding ExportImages, Mode=TwoWay}" />
          <CheckBox Content="Inline images in HTML" IsChecked="{CompiledBinding ExportInlineImages, Mode=TwoWay}" />
          <CheckBox Content="Include tool calls and tool outputs" IsChecked="{CompiledBinding ExportToolCallResults, Mode=TwoWay}" />
          <WrapPanel HorizontalAlignment="Right">
            <Button Classes="primary" Content="Start Export" Command="{CompiledBinding ConfirmExportCommand}" />
            <Button Classes="ghost" Content="Cancel" Command="{CompiledBinding DismissDialogsCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border Grid.RowSpan="4" Background="#AA000000" IsVisible="{CompiledBinding BatchExportDialogVisible}">
      <Border Classes="panel" Margin="40" Padding="20" MaxWidth="1180" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
          <StackPanel Spacing="12">
            <StackPanel Spacing="4">
              <TextBlock Classes="kicker" Text="BATCH EXPORT" />
              <TextBlock Text="Export visible sessions" FontSize="28" FontWeight="Bold" />
              <TextBlock Classes="muted" Text="Choose the sessions and destination folder. Each file uses the session name and its UTC start timestamp." TextWrapping="Wrap" />
            </StackPanel>
            <Grid ColumnDefinitions="Auto,Auto,150,*,Auto" ColumnSpacing="8">
              <Button Classes="ghost" Content="Select All" Command="{CompiledBinding SelectAllBatchExportCommand}" />
              <Button Grid.Column="1" Classes="ghost" Content="Clear All" Command="{CompiledBinding ClearBatchExportCommand}" />
              <ComboBox Grid.Column="2" ItemsSource="{CompiledBinding ExportFormats}" SelectedItem="{CompiledBinding ExportFormat, Mode=TwoWay}" />
              <TextBox Grid.Column="3"
                       PlaceholderText="Target folder"
                       Text="{CompiledBinding BatchExportDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="4" Classes="ghost" Content="Browse..." Command="{CompiledBinding BrowseBatchExportDirectoryCommand}" />
            </Grid>
            <WrapPanel>
              <CheckBox Content="Include images" IsChecked="{CompiledBinding ExportImages, Mode=TwoWay}" />
              <CheckBox Content="Inline images in HTML" IsChecked="{CompiledBinding ExportInlineImages, Mode=TwoWay}" />
              <CheckBox Content="Include tool calls and tool outputs" IsChecked="{CompiledBinding ExportToolCallResults, Mode=TwoWay}" />
            </WrapPanel>
          </StackPanel>

          <Border Grid.Row="1" Classes="card" Padding="0">
            <Grid RowDefinitions="Auto,*">
              <Grid ColumnDefinitions="52,2*,180,3*" ColumnSpacing="10" Margin="12,10">
                <TextBlock Classes="kicker" Text="USE" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="kicker" Text="SESSION" />
                <TextBlock Grid.Column="2" Classes="kicker" Text="STARTED" />
                <TextBlock Grid.Column="3" Classes="kicker" Text="PROPOSED OUTPUT" />
              </Grid>
              <ListBox Grid.Row="1"
                       Classes="session-list"
                       ItemsSource="{CompiledBinding BatchExportSessions}"
                       Padding="8">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:BatchExportSessionViewModel">
                    <Border Classes="card" Padding="10">
                      <Grid ColumnDefinitions="42,2*,180,3*" ColumnSpacing="10">
                        <CheckBox IsChecked="{CompiledBinding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{CompiledBinding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{CompiledBinding StartedAtLabel}" Classes="muted" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{CompiledBinding OutputFileName}" Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="{CompiledBinding BatchExportSelectionText}" Classes="muted" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="primary" Content="Export" Command="{CompiledBinding ConfirmBatchExportCommand}" />
            <Button Grid.Column="2" Classes="ghost" Content="Cancel" Command="{CompiledBinding DismissDialogsCommand}" />
          </Grid>
        </Grid>
      </Border>
    </Border>

    <Border Grid.RowSpan="4" Background="#88000000" IsVisible="{CompiledBinding SanitizeDialogVisible}">
      <Border Classes="panel" Width="760" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock Classes="kicker" Text="SANITIZED OUTPUT" />
          <TextBlock Text="{CompiledBinding SelectedTitle}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
          <TextBox PlaceholderText="Chat name" Text="{CompiledBinding SanitizeChatName, Mode=TwoWay}" />
          <CheckBox Content="Strip image content" IsChecked="{CompiledBinding SanitizeStripImageContent, Mode=TwoWay}" IsEnabled="False" />
          <CheckBox Content="Strip all blobs" IsChecked="{CompiledBinding SanitizeStripBlobContent, Mode=TwoWay}" />
          <CheckBox Content="Create new JSONL copy file" IsChecked="{CompiledBinding SanitizeCreateJsonlCopy, Mode=TwoWay}" />
          <CheckBox Content="Re-add session to current day" IsChecked="{CompiledBinding SanitizeReAddToCurrentDay, Mode=TwoWay}" IsEnabled="False" />
          <TextBlock Classes="muted" Text="The source session is left unchanged. Output is written to a fresh temporary folder." TextWrapping="Wrap" />
          <WrapPanel HorizontalAlignment="Right">
            <Button Classes="primary" Content="Create Sanitized Output" Command="{CompiledBinding ConfirmSanitizeCommand}" />
            <Button Classes="ghost" Content="Cancel" Command="{CompiledBinding DismissDialogsCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border Grid.RowSpan="4" Background="#88000000" IsVisible="{CompiledBinding ExportProgressVisible}">
      <Border Classes="panel" Width="640" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock Text="{CompiledBinding OperationTitle}" FontSize="24" FontWeight="Bold" />
          <ProgressBar Minimum="0" Maximum="100" Value="{CompiledBinding OperationProgress}" />
          <Grid Height="46" ClipToBounds="True">
            <TextBlock Text="{CompiledBinding OperationMessage}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
          </Grid>
          <TextBlock Classes="muted" Text="{CompiledBinding OperationStage}" />
          <SelectableTextBlock Text="{CompiledBinding OperationOutputPath}" IsVisible="{CompiledBinding HasOperationOutput}" TextWrapping="Wrap" />
          <WrapPanel HorizontalAlignment="Right">
            <Button Classes="ghost" Content="Reveal" Command="{CompiledBinding RevealOperationOutputCommand}" IsVisible="{CompiledBinding HasOperationOutput}" />
            <Button Classes="primary" Content="Close" Command="{CompiledBinding DismissDialogsCommand}" IsVisible="{CompiledBinding CanCloseOperationProgress}" />
            <Button Classes="ghost" Content="Cancel" Command="{CompiledBinding CancelOperationCommand}" IsVisible="{CompiledBinding IsOperationRunning}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border Grid.RowSpan="4" Background="#88000000" IsVisible="{CompiledBinding SanitizeProgressVisible}">
      <Border Classes="panel" Width="640" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock Text="{CompiledBinding OperationTitle}" FontSize="24" FontWeight="Bold" />
          <ProgressBar Minimum="0" Maximum="100" Value="{CompiledBinding OperationProgress}" />
          <Grid Height="46" ClipToBounds="True">
            <TextBlock Text="{CompiledBinding OperationMessage}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
          </Grid>
          <SelectableTextBlock Text="{CompiledBinding OperationOutputPath}" IsVisible="{CompiledBinding HasOperationOutput}" TextWrapping="Wrap" />
          <WrapPanel HorizontalAlignment="Right">
            <Button Classes="ghost" Content="Reveal" Command="{CompiledBinding RevealOperationOutputCommand}" IsVisible="{CompiledBinding HasOperationOutput}" />
            <Button Classes="primary" Content="Close" Command="{CompiledBinding DismissDialogsCommand}" IsVisible="{CompiledBinding CanCloseOperationProgress}" />
            <Button Classes="ghost" Content="Cancel" Command="{CompiledBinding CancelOperationCommand}" IsVisible="{CompiledBinding IsOperationRunning}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border Grid.RowSpan="4" Background="#AA000000" IsVisible="{CompiledBinding TranscriptDialogVisible}">
      <Border Classes="panel" Margin="24" Padding="18">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <StackPanel>
              <TextBlock Classes="kicker" Text="SESSION REPLAY" />
              <TextBlock Text="{CompiledBinding SelectedTitle}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="{CompiledBinding TranscriptMetaText}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" Content="Copy All" Command="{CompiledBinding CopyAllTranscriptCommand}" />
            <Button Grid.Column="2" Classes="primary" Content="Close" Command="{CompiledBinding CloseTranscriptCommand}" />
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox PlaceholderText="Search transcript..." Text="{CompiledBinding TranscriptSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Grid.Column="1" Content="Show tool calls" IsChecked="{CompiledBinding TranscriptShowToolCalls, Mode=TwoWay}" VerticalAlignment="Center" />
          </Grid>
          <ListBox Grid.Row="2" ItemsSource="{CompiledBinding TranscriptEntries}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TranscriptEntryViewModel">
                <Border Classes="card" Margin="0,0,0,10">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <TextBlock Text="{CompiledBinding Title}" FontWeight="Bold" />
                      <TextBlock Grid.Column="1" Text="{CompiledBinding TimestampLabel}" Classes="muted" />
                      <Button Grid.Column="2"
                              Classes="ghost"
                              Content="Copy"
                              Command="{ReflectionBinding DataContext.CopyTranscriptEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{ReflectionBinding}" />
                    </Grid>
                    <SelectableTextBlock Text="{CompiledBinding Text}" FontFamily="Cascadia Code, Consolas" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Border>

    <Border Grid.RowSpan="4" Background="#88000000" IsVisible="{CompiledBinding TokenSummaryDialogVisible}">
      <Border Classes="panel" Width="900" MaxHeight="820" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <StackPanel Spacing="3">
              <TextBlock Classes="kicker" Text="TOKEN ANALYSIS" />
              <TextBlock Text="{CompiledBinding TokenSummaryTitle}" FontSize="24" FontWeight="Bold" />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" Content="Export">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="PNG Image" Command="{CompiledBinding ExportTokenSummaryCommand}" CommandParameter="png" />
                  <MenuItem Header="CSV" Command="{CompiledBinding ExportTokenSummaryCommand}" CommandParameter="csv" />
                  <MenuItem Header="Markdown" Command="{CompiledBinding ExportTokenSummaryCommand}" CommandParameter="md" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button Grid.Column="2" Classes="ghost" Content="Copy Summary" Command="{CompiledBinding CopyTokenSummaryCommand}" />
          </Grid>
          <StackPanel Grid.Row="1" Spacing="7">
            <ProgressBar Minimum="0" Maximum="100" Value="{CompiledBinding TokenSummaryProgress}" />
            <TextBlock Text="{CompiledBinding TokenSummaryMessage}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <ScrollViewer Grid.Row="2" IsVisible="{CompiledBinding HasTokenSummaryResult}">
            <Border x:Name="TokenSummaryReport" Background="{DynamicResource PanelBackgroundBrush}" Padding="4">
              <StackPanel Spacing="18">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{CompiledBinding TokenSummaryPeriodTitle}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{CompiledBinding TokenSummaryTotalCostText}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
              </Grid>

              <UniformGrid Columns="5" Rows="1">
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                  <TextBlock Classes="muted" Text="Input" HorizontalAlignment="Center" />
                  <TextBlock Text="{CompiledBinding TokenSummaryInputText}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                  <TextBlock Classes="muted" Text="Output" HorizontalAlignment="Center" />
                  <TextBlock Text="{CompiledBinding TokenSummaryOutputText}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                  <TextBlock Classes="muted" Text="Cache Write" HorizontalAlignment="Center" />
                  <TextBlock Text="{CompiledBinding TokenSummaryCacheWriteText}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                  <TextBlock Classes="muted" Text="Cache Read" HorizontalAlignment="Center" />
                  <TextBlock Text="{CompiledBinding TokenSummaryCacheReadText}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                  <TextBlock Classes="muted" Text="Total" HorizontalAlignment="Center" />
                  <TextBlock Text="{CompiledBinding TokenSummaryGrandTotalText}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>
              </UniformGrid>

              <StackPanel Spacing="8">
                <TextBlock Classes="kicker" Text="DAILY USAGE" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{CompiledBinding TokenSummaryDailyBars}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TokenUsageDailyBarViewModel">
                        <Grid RowDefinitions="94,Auto" Width="26" ToolTip.Tip="{CompiledBinding TokensText}">
                          <Border Width="13"
                                  Height="{CompiledBinding Height}"
                                  Background="#C7B3A093"
                                  CornerRadius="3"
                                  VerticalAlignment="Bottom"
                                  HorizontalAlignment="Center" />
                          <TextBlock Grid.Row="1" Text="{CompiledBinding DayLabel}" Classes="muted" HorizontalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>

              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="12">
                  <TextBlock Classes="kicker" Text="MODEL" />
                  <TextBlock Grid.Column="1" Classes="kicker" Text="TOKENS" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="2" Classes="kicker" Text="COST" HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{CompiledBinding TokenSummaryModelRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TokenUsageModelRowViewModel">
                      <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="12" Margin="0,5">
                        <TextBlock Text="{CompiledBinding Model}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{CompiledBinding TokensText}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="{CompiledBinding CostText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <TextBlock Text="{CompiledBinding TokenSummaryResultText}" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="{CompiledBinding TokenSummaryPricingNote}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </ScrollViewer>
          <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
            <Button Classes="primary" Content="Close" Command="{CompiledBinding DismissDialogsCommand}" IsVisible="{CompiledBinding CanCloseTokenSummary}" />
            <Button Classes="ghost" Content="Cancel" Command="{CompiledBinding CancelTokenSummaryCommand}" IsVisible="{CompiledBinding IsTokenSummaryRunning}" />
          </WrapPanel>
        </Grid>
      </Border>
    </Border>

    <Border Grid.RowSpan="4" Background="#AA000000" IsVisible="{CompiledBinding OptionsDialogVisible}">
      <Border Classes="panel" Width="940" MaxHeight="820" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
          <StackPanel Spacing="3">
            <TextBlock Classes="kicker" Text="OPTIONS" />
            <TextBlock Text="Anthropic model pricing" FontSize="26" FontWeight="Bold" />
            <TextBlock Text="{CompiledBinding PricingStatus}" Classes="muted" TextWrapping="Wrap" />
            <SelectableTextBlock Text="{CompiledBinding PricingSourceUrl}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <Grid Grid.Row="1" ColumnDefinitions="2*,*,*,*,*,*" ColumnSpacing="12" Margin="0,6,0,0">
            <TextBlock Classes="kicker" Text="MODEL" />
            <TextBlock Grid.Column="1" Classes="kicker" Text="INPUT" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="2" Classes="kicker" Text="CACHE WRITE (5 MIN)" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Classes="kicker" Text="CACHE WRITE (1 H)" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="4" Classes="kicker" Text="CACHE READ" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="5" Classes="kicker" Text="OUTPUT" HorizontalAlignment="Right" />
          </Grid>
          <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{CompiledBinding AnthropicPricingRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AnthropicPricingRowViewModel">
                  <Grid ColumnDefinitions="2*,*,*,*,*,*" ColumnSpacing="12" Margin="0,6">
                    <TextBlock Text="{CompiledBinding Model}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{CompiledBinding InputText}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="{CompiledBinding CacheWrite5MinuteText}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="{CompiledBinding CacheWrite1HourText}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="{CompiledBinding CacheReadText}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="{CompiledBinding OutputText}" HorizontalAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
            <Button Classes="primary" Content="{CompiledBinding PricingRefreshButtonText}" Command="{CompiledBinding RefreshPricingCommand}" />
            <Button Classes="ghost" Content="Close" Command="{CompiledBinding DismissDialogsCommand}" />
          </WrapPanel>
        </Grid>
      </Border>
    </Border>

    <Border Grid.RowSpan="4"
            Margin="-20"
            Padding="20"
            Background="{DynamicResource AppBackgroundBrush}"
            IsVisible="{CompiledBinding StartupLoadingVisible}">
      <Border Classes="panel" Width="620" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="clodlogs" FontSize="46" FontFamily="Georgia" FontWeight="Bold" />
          <StackPanel Spacing="5">
            <TextBlock Classes="kicker" Text="STARTING" />
            <TextBlock Text="Loading sessions..." FontSize="28" FontWeight="Bold" />
            <TextBlock Text="{CompiledBinding StartupLoadingMessage}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <ProgressBar Height="8" IsIndeterminate="True" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Classes="muted"
                       Text="Session folders with large or numerous JSONL files may need 30 seconds or more to scan."
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="ghost" Content="Stop Scan" Command="{CompiledBinding StopStartupScanCommand}" />
          </Grid>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
